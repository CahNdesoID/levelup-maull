# Optional cloud backup. Leave every value blank to run fully offline —
# the app works without any of this and keeps using localStorage.
#
# Copy to `.env` and fill in, then rebuild. See README.md → "Cloud backup"
# for the table definition, the RLS policy, and the security trade-off.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to "lum_snapshots".
VITE_SUPABASE_TABLE=
